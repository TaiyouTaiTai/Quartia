# Plantilla para PRODUCCIÓN. En el servidor, cópiala como .env y reemplaza
# cada <...> con el valor real. El .env real NUNCA se sube a Git.
#
# Diferencias con .env.example (desarrollo):
#   - NODE_ENV=production: el servidor exige CORS_ORIGIN y no arranca sin él.
#   - Usuario de MySQL propio de la app, no root.
#   - JWT_SECRET distinto al de desarrollo (si se filtra, cualquiera puede
#     hacerse pasar por cualquier usuario).

NODE_ENV=production

# --- Base de datos MySQL ---
# Crea un usuario solo para la app, con permisos solo sobre su base:
#   CREATE USER '<usuario_db>'@'<host_app>' IDENTIFIED BY '<clave_db>';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON estadistica_app.* TO '<usuario_db>'@'<host_app>';
DB_HOST=<host_de_mysql>
DB_PORT=3306
DB_USER=<usuario_db>
DB_PASSWORD=<clave_db_larga_y_aleatoria>
DB_NAME=estadistica_app

# --- Servidor ---
PORT=3000
# Cuántos proxies hay delante de la app (Railway, Render, Cloudflare…). Con 1 el
# límite de intentos del login ve la IP real de cada usuario.
TRUST_PROXY=1
# Dominio(s) del frontend, separados por coma. Obligatorio en producción.
CORS_ORIGIN=https://<dominio_del_frontend>

# --- Autenticación ---
# Genera uno NUEVO (no reutilices el de desarrollo):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<secreto_de_al_menos_32_caracteres>
JWT_EXPIRES=7d

# --- Límites de datos ---
MAX_FILE_MB=5
MAX_FILAS=50000
MAX_COLUMNAS=200

# --- Catálogo didáctico (solo para `npm run seed`) ---
CATALOGO_PATH=<ruta_a>/estadistica-visual/db/seed/catalogo.json
