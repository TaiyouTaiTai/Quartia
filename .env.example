# Copia este archivo como .env y rellena tus valores reales.
# El .env real NO se sube a Git (está en .gitignore).

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cambia_esto
DB_NAME=estadistica_app

# --- Servidor ---
PORT=3000
# Orígenes permitidos para CORS, separados por coma (vacío = cualquiera, solo para desarrollo)
CORS_ORIGIN=http://localhost:5173

# --- Autenticación ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=genera_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRES=7d

# --- Límites de datos ---
MAX_FILE_MB=5
MAX_FILAS=50000
MAX_COLUMNAS=200

# --- Catálogo didáctico (lo usa `npm run seed`) ---
CATALOGO_PATH=../../estadistica-visual/db/seed/catalogo.json
